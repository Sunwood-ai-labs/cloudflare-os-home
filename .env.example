# The project-local LiteLLM service uses this key for its OpenAI-compatible API.
# Keep this file as a template and put real values in .env.
LITELLM_MASTER_KEY=sk-change-me

# Provider keys copied from the existing LiteLLM deployment.
ZAI_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=

# Optional AWS Bedrock Mantle models use the copied secrets/aws files.
AWS_PROFILE=default
AWS_REGION=us-east-1
BEDROCK_MANTLE_REGION=us-east-1

# Tailscale Serve endpoint for the browser-side WebSocket connection.
# Change the hostname/port if your Tailscale hostname differs.
CFOS_PUBLIC_BASE_URL=http://localhost:8877
CFOS_BACKEND_HOST=localhost:8877

# Host-only diagnostic port for project-local LiteLLM.
LITELLM_HOST_PORT=4001
LITELLM_TAG=v1.93.0
