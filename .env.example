# The project-local LiteLLM service uses this key for its OpenAI-compatible API.
# Keep this file as a template and put real values in .env.
LITELLM_MASTER_KEY=sk-change-me

# Provider keys copied from the existing LiteLLM deployment.
ZAI_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=

# Optional AWS Bedrock Mantle models use the copied secrets/aws files.
AWS_PROFILE=default
AWS_REGION=us-east-1
BEDROCK_MANTLE_REGION=us-east-1

# Tailscale Serve endpoint for the browser-side WebSocket connection.
# Change the hostname/port if your Tailscale hostname differs.
CFOS_PUBLIC_BASE_URL=http://localhost:8877
CFOS_BACKEND_HOST=localhost:8877

# Host-only diagnostic port for project-local LiteLLM.
LITELLM_HOST_PORT=4001
LITELLM_TAG=v1.93.0

# agent-runner: coding agents (Claude Code/GLM, Codex, Antigravity, Hermes) exposed through LiteLLM.
# Shared secret between LiteLLM and agent-runner (generate any long random string).
AGENT_RUNNER_TOKEN=change-me
# Required host paths only when enabling docker-compose.agents.yml.
# Antigravity paths must exist inside the container engine's Linux machine.
# CODEX_AUTH_FILE=C:/Users/<you>/.codex/auth.json
# ANTIGRAVITY_RUNTIME_DIR=/path/to/antigravity-acp/linux-x64/versions/<version>
# ANTIGRAVITY_PROFILE_DIR=/path/to/signed-in/antigravity/profile
# CLAUDE_CODE_GLM_MODEL=glm-5.2
# HERMES_MODEL=glm-5.2
# Pi MCP bridge: lifetime of paused native sessions and maximum retained sessions.
# AGENT_RUNNER_MCP_SESSION_TTL_SECONDS=1800
# AGENT_RUNNER_MCP_MAX_SESSIONS=16
# agent-team roles (any agent id above) and review/fix rounds.
# TEAM_PLANNER=antigravity
# TEAM_IMPLEMENTER=claude-code-glm
# TEAM_REVIEWER=codex
# TEAM_SUMMARIZER=hermes
# TEAM_MAX_FIX_ROUNDS=2
# Stage icons: Font Awesome via the Iconify CDN (default), or TEAM_ICONS=emoji to avoid the CDN request.
# TEAM_ICONS=emoji
